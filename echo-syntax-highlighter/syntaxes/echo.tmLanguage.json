{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Echo",
  "scopeName": "source.echo",
  "fileTypes": ["echo"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#function-definitions" },
    { "include": "#type-definitions" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#literals" },
    { "include": "#builtins" },
    { "include": "#function-calls" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#constants" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.echo",
          "begin": "//",
          "end": "$"
        },
        {
          "name": "comment.block.echo",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.double.echo",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            { "include": "#string-escape" },
            { "include": "#interpolation" }
          ]
        },
        {
          "name": "string.quoted.triple.single.echo",
          "begin": "'''",
          "end": "'''",
          "patterns": [
            { "include": "#string-escape" },
            { "include": "#interpolation" }
          ]
        },
        {
          "name": "string.quoted.double.echo",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#string-escape" },
            { "include": "#interpolation" }
          ]
        },
        {
          "name": "string.quoted.single.echo",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "include": "#string-escape" },
            { "include": "#interpolation" }
          ]
        }
      ]
    },
    "string-escape": {
      "name": "constant.character.escape.echo",
      "match": "\\\\."
    },
    "interpolation": {
      "name": "meta.interpolation.echo",
      "begin": "\\$\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.section.interpolation.begin.echo" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.interpolation.end.echo" }
      },
      "contentName": "source.echo.embedded",
      "patterns": [
        { "include": "#nested-braces" },
        { "include": "$self" }
      ]
    },
    "nested-braces": {
      "begin": "\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.section.braces.begin.echo" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.braces.end.echo" }
      },
      "patterns": [
        { "include": "#nested-braces" },
        { "include": "$self" }
      ]
    },
    "function-definitions": {
      "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.function.echo" },
        "2": { "name": "entity.name.function.echo" }
      }
    },
    "type-definitions": {
      "match": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.type.echo" },
        "2": { "name": "entity.name.type.echo" }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.echo",
          "match": "\\b(if|else|while|for|foreach|return|break|continue)\\b"
        },
        {
          "name": "keyword.control.loop.echo",
          "match": "\\b(in|by)\\b"
        },
        {
          "name": "keyword.control.import.echo",
          "match": "\\b(import|export|from|use)\\b"
        },
        {
          "name": "storage.modifier.echo",
          "match": "\\b(mut|watch)\\b"
        },
        {
          "name": "storage.type.function.echo",
          "match": "\\bfn\\b"
        },
        {
          "name": "keyword.declaration.type.echo",
          "match": "\\btype\\b"
        }
      ]
    },
    "types": {
      "name": "storage.type.echo",
      "match": "\\b(int|float|str|bool|list|hash|dynamic|void)\\b"
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.language.boolean.echo",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.echo",
          "match": "\\bnull\\b"
        }
      ]
    },
    "builtins": {
      "name": "support.function.builtin.echo",
      "match": "\\b(abs|args|asBool|asFloat|asFloatOr|asInt|asIntOr|ask|assert|asString|ceil|clone|contains|copyFile|countOf|cwd|default|empty|endsWith|ensure|env|envOr|eprint|exit|expect|expectEq|expectNeq|fail|fileExists|find|floor|format|has|indexOf|insertAt|isDir|join|keys|lastIndexOf|length|listFiles|lowerCase|max|merge|min|mkdir|now|order|padEnd|padStart|pairs|parseJson|parseJsonOr|pathJoin|pull|push|random|randomInt|readFile|readFileOr|readLine|removeFile|removeValue|repeat|replace|replaceFirst|reverse|run|say|slice|split|startsWith|take|take_last|trim|type|upperCase|values|wait|wipe|writeFile|writeJson)\\s*(?=\\()"
    },
    "function-calls": {
      "name": "entity.name.function.echo",
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()"
    },
    "numbers": {
      "name": "constant.numeric.echo",
      "match": "(?<![0-9A-Za-z_])(?:\\.[0-9]+|[0-9]+(?:\\.[0-9]+)?)(?:[eE][+-]?[0-9]+)?"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.compound.echo",
          "match": "\\+=|-=|\\*=|/=|%="
        },
        {
          "name": "keyword.operator.arrow.echo",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.logical.echo",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.comparison.echo",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.range.echo",
          "match": "\\.\\.\\.|\\.\\."
        },
        {
          "name": "keyword.operator.assignment.echo",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.echo",
          "match": "[+\\-*/%]"
        },
        {
          "name": "punctuation.accessor.echo",
          "match": "\\."
        }
      ]
    },
    "constants": {
      "name": "variable.other.constant.echo",
      "match": "\\b[A-Z_][A-Z0-9_]*\\b"
    }
  }
}
