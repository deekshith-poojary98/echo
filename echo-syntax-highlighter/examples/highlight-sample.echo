/* block comment */

name: str = "Echo ${1 + 2}";
body: str = """
hello ${name.trim()}
""";

n: float = .5;
sci: float = 1e-3;

if n > 0 {
    say(name);
} else {
    eprint("no");
}

fn add(a: int, b: int) -> int {
    return a + b;
}

type User = { id: int, name: str };

assert(true, "ok");
fail("unsupported");

items: list = [1, 2];
items.push(3);
raw: str = readFileOr("x.txt", "");
value: int = asIntOr("nope", 0);

for i: int in 0...10 by 2 {
    say(i);
}
nums: list = 0...5;
evens: list = 0...10 by 2;

watch n;
use mut n;

double: fn(int) -> int = fn(x: int) -> int { return x * 2; };
mid: list = items[0:1];
tail: list = items[1:];
head: list = items[:1];
copy: list = items[:];
doubled: list = items.map(double);
evens: list = filter(items, fn(x: int) -> bool { return x % 2 == 0; });
total: int = items.reduce(0, fn(acc: int, x: int) -> int { return acc + x; });
items.forEach(fn(x: int) { say(x); });
duped: list = items.flatMap(fn(x: int) -> list { return [x, x]; });
has_two: bool = items.some(fn(x: int) -> bool { return x == 2; });
all_positive: bool = items.every(fn(x: int) -> bool { return x > 0; });
idx: int = items.findIndex(fn(x: int) -> bool { return x == 2; });
paired: list = zip(items, [10, 20]);
deduped: list = items.unique();
fn join(punct: str = ",", parts: str...) {
    say(parts.join(punct));
}

const title: str = "Echo";
[head: int, rest: int...] = items;
{ id: int, name: str } = { id: 1, name: title };
fn addPair([a: int, b: int]) -> int {
    return a + b;
}

print: fn(str) -> dynamic = say;
apply: fn(list, fn(int) -> int) -> list = map;
type ExactUser = exact { id: int, name: str };
user: ExactUser = { id: 1, name: title };
type Id = int | str;
id: Id = 1;
id = "x";

