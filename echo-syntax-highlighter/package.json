{
  "name": "echo-syntax-highlighter",
  "displayName": "Echo Syntax Highlighter",
  "description": "Syntax highlighting for the Echo programming language (.echo files) in Visual Studio Code and Cursor.",
  "version": "0.5.6",
  "publisher": "deekshith-poojary98",
  "license": "MIT",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "echo",
    "echolang",
    "syntax highlighting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/deekshith-poojary98/echo",
    "directory": "echo-syntax-highlighter"
  },
  "contributes": {
    "languages": [
      {
        "id": "echo",
        "aliases": [
          "Echo",
          "echo"
        ],
        "extensions": [
          ".echo"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "echo",
        "scopeName": "source.echo",
        "path": "./syntaxes/echo.tmLanguage.json"
      }
    ]
  }
}
