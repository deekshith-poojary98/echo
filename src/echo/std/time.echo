// Echo std/time (2.0.6; `now` / `wait` added in 2.1.6).
// Canonical home for UTC date / duration / clock helpers. Prelude still
// exposes the same names for a compatibility window (see 2.0.7 prelude policy).

export now: dynamic = now;
export wait: dynamic = wait;
export formatTime: dynamic = formatTime;
export parseTime: dynamic = parseTime;
export days: dynamic = days;
export hours: dynamic = hours;
export minutes: dynamic = minutes;
