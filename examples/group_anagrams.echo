// LeetCode 49: Group Anagrams
// Sort each string's chars as a key, bucket into hash by that key.

fn sorted_key(s: str) -> str {
    chars: list = (0...s.length()).map(fn(i: int) -> str {
        return s[i];
    });
    chars.order();
    return chars.join("");
}

fn group_anagrams(strs: list) -> list {
    groups: hash = {};

    strs.forEach(fn(s: str) {
        use mut groups;
        k: str = sorted_key(s);
        if !groups.has(k) {
            groups[k] = [];
        }
        groups[k].push(s);
    });

    return groups.values();
}

say(group_anagrams(["eat", "tea", "tan", "ate", "nat", "bat"]));
say(group_anagrams([""]));
say(group_anagrams(["a"]));
