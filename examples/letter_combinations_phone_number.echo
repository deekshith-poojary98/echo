// LeetCode 17: Letter Combinations of a Phone Number

const keypad: hash = {
    "2": "abc",
    "3": "def",
    "4": "ghi",
    "5": "jkl",
    "6": "mno",
    "7": "pqrs",
    "8": "tuv",
    "9": "wxyz"
};

fn letter_combinations(digits: str) -> list {
    if digits.length() == 0 {
        return [];
    }

    result: list = [""];
    i: int = 0;
    while i < digits.length() {
        letters: str = keypad[digits[i]];
        result = result.flatMap(fn(prefix: str) -> list {
            return (0...letters.length()).map(fn(j: int) -> str {
                return prefix + letters[j];
            });
        });
        i = i + 1;
    }

    return result;
}

say(letter_combinations("23"));
say(letter_combinations("2"));
